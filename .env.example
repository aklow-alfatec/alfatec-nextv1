# Names only. Copy values for local dev from ../alfatec-nextv0/.env.local (do not commit real values).
# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST=
# Read-only access to the existing nextv0 `users` table
POSTGRES_URL=
# Engine API (server-side only; never prefix with NEXT_PUBLIC_)
ENGINE_API_URL=
ENGINE_API_SECRET=
# Local development: use this backend instead when it answers its health check (leave unset on Vercel)
ENGINE_LOCAL_URL=
ENGINE_LOCAL_SECRET=
# 0 = studio reads go to the engine API instead of the database
NEXT_PUBLIC_STUDIO_DB_READS=
